{
    "name": "DCSLab API",
    "dockerComposeFile": [
        "../../docker-compose.yml"
    ],
    "service": "api",
    "remoteUser": "www-data",
    "workspaceFolder": "/var/www/html",
    "shutdownAction": "none",
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "bmewburn.vscode-intelephense-client",
                "sirtori.indenticator",
                "xdebug.php-debug"
            ]
        }
    }
}